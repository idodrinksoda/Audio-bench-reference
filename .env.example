# Copy to .env and fill in. All paths are relative to the repo root unless absolute.

# Required only for the batch indexer (atlas/indexer). The server/viewer never use it.
ANTHROPIC_API_KEY=

# Local server port
PORT=8420

# Where device folders live (each fully self-contained and portable)
DEVICES_DIR=devices

# Shared datasheet cache, keyed by part number
PARTSDB_DIR=partsdb
